{
  "name": "@rios0rios0/backstage-plugin-code-health-backend",
  "version": "5.2.0",
  "description": "Backstage backend plugin that ingests repository history from the catalog's GitHub and Azure DevOps repositories into the Backstage database, and serves it to the Code Health dashboard",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "config.d.ts",
    "docs/*.md",
    "migrations/**/*.{js,d.ts}",
    "LICENSE",
    "README.md"
  ],
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "code-health",
    "pluginPackages": [
      "@rios0rios0/backstage-plugin-code-health",
      "@rios0rios0/backstage-plugin-code-health-backend",
      "@rios0rios0/backstage-plugin-code-health-common"
    ]
  },
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rios0rios0/backstage-plugin-code-health.git",
    "directory": "plugins/code-health-backend"
  },
  "homepage": "https://github.com/rios0rios0/backstage-plugin-code-health#readme",
  "bugs": "https://github.com/rios0rios0/backstage-plugin-code-health/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "code-health",
    "github",
    "azure-devops",
    "wakatime",
    "jira",
    "confluence",
    "ci"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint --fix",
    "lint:ci": "backstage-cli package lint",
    "test": "backstage-cli package test --watch=false",
    "test:watch": "backstage-cli package test",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.3",
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/config": "^1.3.8",
    "@backstage/errors": "^1.3.1",
    "@backstage/integration": "^2.0.3",
    "@backstage/plugin-catalog-node": "^2.2.3",
    "@backstage/plugin-permission-common": "^0.9.9",
    "@rios0rios0/backstage-plugin-code-health-common": "^5.2.0",
    "express": "^4.22.2",
    "express-promise-router": "^4.1.1",
    "knex": "^3.3.0",
    "luxon": "^3.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.17.6",
    "@backstage/backend-test-utils": "^1.11.5",
    "@backstage/cli": "^0.36.4",
    "@backstage/types": "^1.2.2",
    "@types/express": "^4.17.25",
    "@types/luxon": "^3.7.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "//jest": "`roots` adds the sibling `test/` directory, because `backstage-cli` roots Jest at `<package>/src`. `collectCoverageFrom` excludes only files that compile to no executable statements — the port interfaces under `domain/repositories` and `domain/services`, and the provider payload types. Entities are measured, because several of them carry real logic. The thresholds themselves are global and live in the workspace root.",
  "jest": {
    "roots": [
      "<rootDir>",
      "<rootDir>/../test"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!domain/repositories/**",
      "!domain/services/**",
      "!infrastructure/services/collectors/*_node.ts"
    ]
  }
}
